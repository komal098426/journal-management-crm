{
  "name": "northstar-erp-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js REST API for Northstar ERP (Express + Supabase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "cors": "2.8.6",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
